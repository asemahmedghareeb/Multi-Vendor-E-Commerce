<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{appName}} — Verification Code</title>
    <style>
      body { font-family: Arial, sans-serif; background:#f5f5f5; margin:0; padding:24px; }
      .container { max-width:500px; margin:0 auto; background:#fff; padding:24px; border-radius:8px; }
      .headline { font-size:20px; font-weight:600; margin-bottom:12px; }
      .lead { margin-bottom:16px; }
      .code { font-family: monospace; font-size:28px; letter-spacing:4px; background:#f0f0f0; padding:12px 18px; border-radius:6px; display:inline-block; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="headline">Your {{appName}} Verification Code</div>
      <div class="lead">
        Use the code below to verify your account.
      </div>
      <div class="code">{{code}}</div>
      <p style="font-size:13px;color:#666;">If you didn’t request this, please ignore this email.</p>
    </div>
  </body>
</html>
