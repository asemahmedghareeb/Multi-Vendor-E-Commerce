<html lang='ar' dir='rtl'>
  <head>
    <meta charset='utf-8' />
    <title>رمز التحقق — {{appName}}</title>
    <style>
      body {
        font-family: Tahoma, Arial, sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 24px;
        direction: rtl;
        text-align: right;
      }
      .container {
        max-width: 500px;
        margin: 0 auto;
        background: #fff;
        padding: 24px;
        border-radius: 8px;
      }
      .headline {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 12px;
      }
      .lead {
        margin-bottom: 16px;
      }
      .code {
        font-family: monospace;
        font-size: 28px;
        letter-spacing: 4px;
        background: #f0f0f0;
        padding: 12px 18px;
        border-radius: 6px;
        display: inline-block;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='headline'>رمز التحقق الخاص بـ {{appName}}</div>
      <div class='lead'>
        استخدم الرمز أدناه لتغيير كلمة السر.
      </div>
      <div class='code'>{{code}}</div>
    </div>
  </body>
</html>